# deploy.sh writes this as .env on the server on first deploy, with secrets filled in.
CORS_ORIGINS=https://movieverse.jefin.xyz
# Proxies in front of the API (Cloudflare + nginx = 2)
TRUST_PROXY_HOPS=2

POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
AI_SERVICE_TOKEN=

# Works for ANY email, so anyone holding it can sign in as anyone. Temporary:
# delete this line and restart once real mail works.
OTP_ESCAPE_CODE=123456

# Without these, no sign-in email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@jefin.xyz

# OAuth client ids allowed to sign in with Google. Empty turns it off.
GOOGLE_CLIENT_IDS=235405567665-pleoekap5tsdk5vjriomb4k0t3uhardm.apps.googleusercontent.com
PROVIDER_REGIONS=IN,US,GB
DAILY_PICK_HOUR_UTC=14

# Needed for where-to-watch, streaming alerts and provider filters.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
