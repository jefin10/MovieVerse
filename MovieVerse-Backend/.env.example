# ---- Server ----
NODE_ENV=development
PORT=8080
# Proxies in front of the API (Cloudflare + nginx = 2)
TRUST_PROXY_HOPS=1
# Comma-separated allowed origins for CORS (web + app)
CORS_ORIGINS=http://localhost:3000

# ---- Database (Prisma / Postgres) ----
DATABASE_URL=postgresql://movieverse:movieverse@localhost:5432/movieverse?schema=public

# ---- Auth ----
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-too
# Sign-in code that always works, for ANY email. Temporary; leave empty to turn off.
OTP_ESCAPE_CODE=123456

# ---- Google sign-in ----
# OAuth client ids allowed to sign in (web and Android), comma-separated. Empty turns it off.
GOOGLE_CLIENT_IDS=

# ---- Streaming and notifications ----
PROVIDER_REGIONS=IN,US,GB
# When Tonight's Pick goes out. 14 UTC is 7:30pm in India.
DAILY_PICK_HOUR_UTC=14
SCHEDULER_ENABLED=true

# ---- TMDB ----
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# ---- AI service (MovieverseAI Flask) ----
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_TOKEN=change-me-shared-with-node

# ---- Mail (sign-in codes) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@movieverse.local
