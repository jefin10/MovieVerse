// Prisma schema ported from the Django api/users models.
// Run: npm run prisma:generate && npm run prisma:migrate
// To adopt an existing DB instead, use: prisma db pull

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String?
  googleId  String?  @unique @map("google_id")
  region    String   @default("IN")
  dailyPickEnabled     Boolean @default(true) @map("daily_pick_enabled")
  providerAlertsEnabled Boolean @default(true) @map("provider_alerts_enabled")
  socialAlertsEnabled  Boolean @default(true) @map("social_alerts_enabled")
  isActive  Boolean  @default(true) @map("is_active")
  isStaff   Boolean  @default(false) @map("is_staff")
  createdAt DateTime @default(now()) @map("date_joined")

  watchlist    Watchlist[]
  ratings      Rating[]
  recommended  RecommendedMovie[]
  swipes       Swipe[]
  providers    UserProvider[]
  following    Follow[]       @relation("Follower")
  followers    Follow[]       @relation("Following")
  pushTokens   PushToken[]
  notifications Notification[]
  hostedRooms  Room[]
  roomMembers  RoomMember[]
  roomSwipes   RoomSwipe[]

  @@map("users")
}

model LoginOTP {
  id             Int       @id @default(autoincrement())
  email          String
  otpHash        String    @map("otp_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  requestIp      String?   @map("request_ip")

  @@index([email, createdAt])
  @@index([expiresAt])
  @@map("login_otps")
}

model Genre {
  id     Int     @id
  name   String
  movies Movie[]

  @@map("genres")
}

model Language {
  iso6391     String  @id @map("iso_639_1")
  englishName String  @default("") @map("english_name")
  name        String  @default("")
  originalFor Movie[] @relation("OriginalLanguage")
  spokenIn    Movie[] @relation("SpokenLanguages")

  @@map("languages")
}

model Country {
  iso31661     String  @id @map("iso_3166_1")
  name         String
  originFor    Movie[] @relation("OriginCountries")
  productionFor Movie[] @relation("ProductionCountries")

  @@map("countries")
}

model Movie {
  id                  Int       @id @default(autoincrement())
  tmdbId              Int?      @unique @map("tmdb_id")
  title               String
  originalTitle       String    @default("") @map("original_title")
  description         String    @default("")
  director            String    @default("")
  star1               String    @default("")
  star2               String    @default("")
  posterUrl           String    @default("") @map("poster_url")
  backdropUrl         String    @default("") @map("backdrop_url")
  releaseDate         DateTime? @map("release_date")
  adult               Boolean   @default(false)
  popularity          Float     @default(0)
  voteCount           Int       @default(0) @map("vote_count")
  tmdbVoteAverage     Float     @default(0) @map("tmdb_vote_average")
  runtime             Int?
  status              String    @default("")
  tagline             String    @default("")
  homepage            String    @default("")
  imdbId              String    @default("") @map("imdb_id")
  trailerKey          String    @default("") @map("trailer_key")
  trailerUrl          String    @default("") @map("trailer_url")
  trailerName         String    @default("") @map("trailer_name")
  budget              BigInt    @default(0)
  revenue             BigInt    @default(0)
  imdbRating          Float     @default(0) @map("imdb_rating")
  ourRating           Float     @default(0) @map("our_rating")
  tmdbPayload         Json      @default("{}") @map("tmdb_payload")
  providersSyncedAt   DateTime? @map("providers_synced_at")

  originalLanguage     Language?  @relation("OriginalLanguage", fields: [originalLanguageId], references: [iso6391])
  originalLanguageId   String?    @map("original_language_id")
  spokenLanguages      Language[] @relation("SpokenLanguages")
  originCountries      Country[]  @relation("OriginCountries")
  productionCountries  Country[]  @relation("ProductionCountries")
  genres               Genre[]

  watchlist   Watchlist[]
  ratings     Rating[]
  recommended RecommendedMovie[]
  swipes      Swipe[]
  providers   MovieProvider[]
  roomSwipes  RoomSwipe[]

  @@index([popularity, tmdbVoteAverage, voteCount])
  @@map("movies")
}

model Watchlist {
  id      Int      @id @default(autoincrement())
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int      @map("movie_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int      @map("user_id")
  addedOn DateTime @default(now()) @map("added_on")

  @@index([userId, movieId])
  @@map("watchlist")
}

model Rating {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   Int      @map("movie_id")
  rating    Float
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, movieId])
  @@index([movieId])
  @@map("ratings")
}

model RecommendedMovie {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int      @map("user_id")
  movie         Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId       Int      @map("movie_id")
  recommendedOn DateTime @default(now()) @map("recommended_on")

  @@unique([userId, movieId])
  @@map("recommended_movies")
}

model Swipe {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId   Int      @map("movie_id")
  liked     Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, movieId])
  @@index([userId, liked])
  @@map("swipes")
}

// A streaming service, keyed by TMDB's provider id.
model WatchProvider {
  id       Int     @id
  name     String
  logoPath String  @default("") @map("logo_path")
  movies   MovieProvider[]
  users    UserProvider[]

  @@map("watch_providers")
}

model MovieProvider {
  movie      Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId    Int           @map("movie_id")
  provider   WatchProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId Int           @map("provider_id")
  region     String
  kind       String        // flatrate | rent | buy
  link       String        @default("")

  @@id([movieId, providerId, region, kind])
  @@index([providerId, region, kind])
  @@map("movie_providers")
}

model UserProvider {
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int           @map("user_id")
  provider   WatchProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId Int           @map("provider_id")

  @@id([userId, providerId])
  @@map("user_providers")
}

model Follow {
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  Int      @map("follower_id")
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

model PushToken {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  platform  String   @default("")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_tokens")
}

model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @map("user_id")
  type      String    // daily_pick | provider | follow | room_match
  title     String
  body      String
  imageUrl  String    @default("") @map("image_url")
  data      Json      @default("{}")
  // Stops a restart or retry from sending the same notification twice.
  dedupeKey String    @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Room {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  host      User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId    Int      @map("host_id")
  deck      Int[]
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  members   RoomMember[]
  swipes    RoomSwipe[]

  @@index([expiresAt])
  @@map("rooms")
}

model RoomMember {
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId   Int      @map("room_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  @@id([roomId, userId])
  @@map("room_members")
}

model RoomSwipe {
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId  Int     @map("room_id")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int     @map("user_id")
  movie   Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  movieId Int     @map("movie_id")
  liked   Boolean

  @@id([roomId, userId, movieId])
  @@index([roomId, movieId])
  @@map("room_swipes")
}
